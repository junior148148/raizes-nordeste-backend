    {
      "name": "03 - Pedidos (Multicanal)",
      "item": [
        {
          "name": "T04 - Criar Pedido Valido no canal TOTEM (Positivo - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('Canal registrado como TOTEM', function () { pm.expect(json.canalPedido).to.eql('TOTEM'); });",
                  "pm.collectionVariables.set('pedidoId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": 1,\n  \"canalPedido\": \"TOTEM\",\n  \"itens\": [\n    { \"produtoId\": 1, \"quantidade\": 2 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos"]
            }
          }
        },
        {
          "name": "T05 - Filtrar Pedidos por canalPedido=TOTEM (Positivo - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Retornou pedidos filtrados', function () { pm.expect(json.dados).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenCliente}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos?canalPedido=TOTEM&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["pedidos"],
              "query": [
                { "key": "canalPedido", "value": "TOTEM" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
