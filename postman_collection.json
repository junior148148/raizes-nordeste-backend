    "name": "Raizes do Nordeste - API Back-End",
    "description": "Coleção oficial de testes da API Raízes do Nordeste (15 cenários: 8 positivos e 7 negativos). Execute na ordem numérica após rodar o seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "tokenCliente", "value": "" },
    { "key": "tokenGerente", "value": "" },
    { "key": "pedidoId", "value": "1" }
  ],
  "item": [
    {
      "name": "01 - Auth e LGPD",
      "item": [
        {
          "name": "T01 - Login Cliente valido (Positivo - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Retornou accessToken', function () { pm.expect(json.accessToken).to.be.a('string'); });",
                  "pm.collectionVariables.set('tokenCliente', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "T02 - Login Gerente valido (Positivo - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Perfil GERENTE autenticado', function () { pm.expect(json.user.perfil).to.eql('GERENTE'); });",
                  "pm.collectionVariables.set('tokenGerente', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gerente@raizes.com\",\n  \"senha\": \"Senha@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
